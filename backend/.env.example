APP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-before-running
DATABASE_URL=postgresql+psycopg://ahsan:localdev@localhost:5432/ahsan
ENABLE_MOCK_PAYMENTS=true
# Hour of the day (Asia/Karachi, 0-23) at which a business day closes itself.
# 0 = midnight, so each date is closed and settled just after it ends.
# Set 12 to close each day at noon the next day instead (a grace period).
DAY_CLOSE_HOUR=0
