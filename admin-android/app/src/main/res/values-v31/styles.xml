<resources>
    <style name="Theme.Ahsan" parent="Theme.AhsanBase">
        <item name="android:windowSplashScreenBackground">#0A3B22</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/logo_lockup</item>
    </style>

    <!-- Android 12+ System Splash Screen Theme via androidx.core:core-splashscreen.
         The system splash shows the SAVED logo lockup (AT badge + AHSAN TRADERS
         wordmark) — the exact same image that opens the Compose splash — so the
         user perceives one single branded splash, not a plain green screen. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A3B22</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_lockup</item>
        <item name="postSplashScreenTheme">@style/Theme.Ahsan</item>
    </style>
</resources>
