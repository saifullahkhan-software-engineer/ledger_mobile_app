<resources>
    <style name="Theme.Ahsan" parent="Theme.AhsanBase">
        <item name="android:windowSplashScreenBackground">#0A3B22</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_brand</item>
    </style>

    <!-- Android 12+ System Splash Screen Theme via androidx.core:core-splashscreen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A3B22</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.Ahsan</item>
    </style>
</resources>
